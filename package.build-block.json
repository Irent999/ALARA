{
  "appId": "com.rhbz.vr.simulator",
  "productName": "РХБЗ VR Тренажер",
  "executableName": "RHBZ-VR",
  "asar": true,
  "directories": { "output": "release" },
  "files": [
    { "from": "dist", "to": "dist", "filter": ["**/*"] },
    { "from": "electron", "to": "electron", "filter": ["**/*"] },
    "package.json"
  ],
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "РХБЗ VR Тренажер",
    "language": "1049",
    "artifactName": "RHBZ-VR-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "RHBZ-VR-Portable-${version}.${ext}"
  }
}
